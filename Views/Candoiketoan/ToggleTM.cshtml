<div class="table-responsive">
    <table class="table table-striped table-dark">
        <thead>
            <tr>
                <th class="text-center">
                    Mã số
                </th>
                <th class="text-center">
                    Tài khoản
                </th>
                <th class="text-center">
                    Thành tiền
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        if (item["KyNay"].ToString() != "0")
                    {
                        <tr>
                            <td class="text-center">
                                @item["MaSo"]
                            </td>
                            <td class="text-center">
                                @{
                                    if (@item["Dau"].ToString() == "1")
                                    {

                                        @item["TkCo"]
                                    }
                                    else
                                    {

                                        @item["TkNo"]
                                    }
                                }

                            </td>
                            <td class="text-center">
                                @item["KyNay"].ToString("N0")
                            </td>
                        </tr>
                    }
                        
                    }
                }
            }

        </tbody>
    </table>
</div>